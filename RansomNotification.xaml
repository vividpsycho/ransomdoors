<Window x:Class="rans0m.RansomNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gif="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        Title="JX1DX1" Height="500" Width="760" MinHeight="500" MinWidth="760"
        Background="#171020" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" AllowDrop="True" Loaded="Window_Loaded"
        DragEnter="Window_DragEnter" Drop="Window_Drop" WindowStartupLocation="CenterScreen">
    <Border BorderBrush="#8B70C9" BorderThickness="1" Background="#171020" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="88"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/Taunts/user_reference_1.png" Width="38" Height="38" Stretch="UniformToFill" Margin="0,0,12,0"/>
                    <TextBlock Text="JX1DX1" Foreground="#FFF4C2" FontFamily="Consolas" FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="SESSION" Foreground="#C7B5F2" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" BorderBrush="#59447E" BorderThickness="1" Background="#09070E" Margin="0,0,14,0" ClipToBounds="True">
                    <Image Stretch="UniformToFill" gif:AnimationBehavior.SourceUri="/Assets/Taunts/jx1dx1.gif" gif:AnimationBehavior.AutoStart="True"/>
                </Border>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" BorderBrush="#59447E" BorderThickness="1" Margin="0,0,0,8" Background="#21182E">
                        <Image Source="/Assets/Taunts/user_reference_1.png" Stretch="UniformToFill"/>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="#59447E" BorderThickness="1" Margin="0,0,0,8" Background="#21182E">
                        <Image Source="/Assets/Taunts/user_reference_2.png" Stretch="UniformToFill"/>
                    </Border>
                    <Border Grid.Row="2" BorderBrush="#59447E" BorderThickness="1" Background="#21182E">
                        <Image Source="/Assets/Taunts/user_reference_3.jpg" Stretch="UniformToFill"/>
                    </Border>
                </Grid>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="190"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#59447E" BorderThickness="1" Background="#21182E" Padding="14" Margin="0,0,14,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ITEMS REMAINING" Foreground="#C7B5F2" FontFamily="Consolas" FontSize="11"/>
                        <TextBlock x:Name="txt_ransomLeft" Text="500" Foreground="#FFF4C2" FontFamily="Consolas" FontSize="27" FontWeight="Bold" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" BorderBrush="#8B70C9" BorderThickness="1" Background="#21182E" Padding="10">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="TIME" Foreground="#C7B5F2" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txt_timer" Text="00:00" Foreground="#FFF4C2" FontFamily="Consolas" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>